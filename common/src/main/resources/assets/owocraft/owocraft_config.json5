anRun = hapticVestInteraction.runSensation(\"100,0.1,{:.2f},0,0,0,Impact\".format(intensity), muscle_target_one)\r\n\r\n\r\n    # Break the loop if the duration has passed\r\n    if elapsed_time > duration:\r\n        canRun = False\r\n\r\n    time.sleep(0.1)  # run 10 times a second",
